{
  "name": "Redshift local validation smoke",
  "description": "Connects over stdio and validates a deterministic read-only query without contacting AWS.",
  "transport": "stdio",
  "command": "cargo",
  "args": [
    "run",
    "--locked",
    "--quiet",
    "--manifest-path",
    "Cargo.toml"
  ],
  "env": {
    "REDSHIFT_TOOL_PROFILE": "analytics",
    "RUST_LOG": "off"
  },
  "timeout_ms": 20000,
  "steps": [
    {
      "id": "validate",
      "tool": "validate_sql",
      "input": {
        "sql": "SELECT 1"
      },
      "expect": {
        "content": [
          {
            "type": "text",
            "text": "{\"data\":{\"database_checked\":false,\"parameter_count\":0,\"query_fingerprint\":\"e004ebd5b5532a4b85984a62f8ad48a81aa3460c1ca07701f386135d72cdecf5\",\"valid\":true,\"validation\":\"local_structural\"},\"ok\":true}"
          }
        ]
      }
    }
  ]
}
